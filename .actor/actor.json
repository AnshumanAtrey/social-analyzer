{
    "actorSpecification": 1,
    "name": "social-analyzer",
    "title": "Social Analyzer - Find Social Profiles by Username",
    "description": "Find someone's public profiles from a username, or a list of them, across 950+ sites. Paste a handle, an @handle or a profile link. Filter by site category, country or named sites. Every hit is ranked high, medium or low confidence. Adult and dating sites are never checked. No login, no API key.",
    "version": "1.0",
    "buildTag": "latest",
    "categories": [
        "LEAD_GENERATION",
        "DEVELOPER_TOOLS",
        "AUTOMATION"
    ],
    "input": "./INPUT_SCHEMA.json",
    "output": "./output_schema.json",
    "dockerfile": "../Dockerfile",
    "readme": "../README.md",
    "storages": {
        "dataset": {
            "actorSpecification": 1,
            "title": "Social Analyzer results",
            "description": "One row per profile found, plus one summary row per run (recordType = summary). Adult and dating sites are never checked.",
            "views": {
                "profiles": {
                    "title": "Profiles found",
                    "description": "Every profile that matched, strongest first. Confidence: high means the site clearly recognised the handle, medium is likely, low is a guess worth a manual check.",
                    "transformation": {
                        "fields": [
                            "username",
                            "platform",
                            "link",
                            "confidence",
                            "matchRate",
                            "category",
                            "country",
                            "pageTitle"
                        ],
                        "flatten": []
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "username": {
                                "label": "Username",
                                "format": "text"
                            },
                            "platform": {
                                "label": "Platform",
                                "format": "text"
                            },
                            "link": {
                                "label": "Profile URL",
                                "format": "link"
                            },
                            "confidence": {
                                "label": "Confidence",
                                "format": "text"
                            },
                            "matchRate": {
                                "label": "Match %",
                                "format": "number"
                            },
                            "category": {
                                "label": "Category",
                                "format": "text"
                            },
                            "country": {
                                "label": "Site country",
                                "format": "text"
                            },
                            "pageTitle": {
                                "label": "Page title",
                                "format": "text"
                            }
                        }
                    }
                },
                "summary": {
                    "title": "Run summary",
                    "description": "What was checked and what came back, in one row. The same object is saved as the OUTPUT record of the run's key-value store.",
                    "transformation": {
                        "fields": [
                            "usernames",
                            "usernamesChecked",
                            "sitesPerUsername",
                            "profilesFound",
                            "highConfidence",
                            "mediumConfidence",
                            "lowConfidence",
                            "sitesFailed",
                            "durationSeconds",
                            "message"
                        ]
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "usernames": {
                                "label": "Usernames",
                                "format": "array"
                            },
                            "usernamesChecked": {
                                "label": "Checked",
                                "format": "number"
                            },
                            "sitesPerUsername": {
                                "label": "Sites each",
                                "format": "number"
                            },
                            "profilesFound": {
                                "label": "Profiles",
                                "format": "number"
                            },
                            "highConfidence": {
                                "label": "High",
                                "format": "number"
                            },
                            "mediumConfidence": {
                                "label": "Medium",
                                "format": "number"
                            },
                            "lowConfidence": {
                                "label": "Low",
                                "format": "number"
                            },
                            "sitesFailed": {
                                "label": "Sites unreachable",
                                "format": "number"
                            },
                            "durationSeconds": {
                                "label": "Seconds",
                                "format": "number"
                            },
                            "message": {
                                "label": "What happened",
                                "format": "text"
                            }
                        }
                    }
                }
            }
        }
    }
}
