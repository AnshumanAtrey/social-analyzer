{
    "actorSpecification": 1,
    "name": "social-analyzer",
    "title": "Social Analyzer - Find Social Profiles by Username",
    "description": "Find someone's social media profiles from just a username, across 900+ sites. Paste a handle or a profile link (we clean it), get confidence-ranked results. No login, no cookies, no API key. Clean per-profile export for recruiting, fraud checks, and people search.",
    "version": "1.0",
    "buildTag": "latest",
    "categories": ["LEAD_GENERATION", "DEVELOPER_TOOLS", "AUTOMATION"],
    "input": "./INPUT_SCHEMA.json",
    "output": "./output_schema.json",
    "dockerfile": "../Dockerfile",
    "readme": "../README.md",
    "storages": {
        "dataset": {
            "actorSpecification": 1,
            "title": "Social Analyzer Results",
            "views": {
                "profiles": {
                    "title": "Detected Profiles",
                    "transformation": {
                        "fields": ["username", "platform", "link", "confidence", "rate", "country", "type", "timestamp"]
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "username":   { "label": "Username",   "format": "text" },
                            "platform":   { "label": "Platform",   "format": "text" },
                            "link":       { "label": "URL",        "format": "link" },
                            "confidence": { "label": "Confidence", "format": "text" },
                            "rate":       { "label": "Match rate", "format": "text" },
                            "country":    { "label": "Country",    "format": "text" },
                            "type":       { "label": "Category",   "format": "text" }
                        }
                    }
                },
                "summary": {
                    "title": "Run Summary",
                    "transformation": {
                        "fields": ["recordType", "username", "mode", "sitesChecked", "profilesFound", "duration", "timestamp"]
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "username":      { "label": "Username",     "format": "text" },
                            "mode":          { "label": "Mode",         "format": "text" },
                            "sitesChecked":  { "label": "Sites",        "format": "number" },
                            "profilesFound": { "label": "Found",        "format": "number" },
                            "duration":      { "label": "Duration (s)", "format": "number" }
                        }
                    }
                }
            }
        }
    }
}
