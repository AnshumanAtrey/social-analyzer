{
    "actorSpecification": 1,
    "name": "social-analyzer",
    "title": "Social Media Finder - Social Analyzer | Username 900+ Sites",
    "description": "Find someone's public profiles from a username, or a list of them, across all 999 sites the scanner knows, every run. Paste a handle, an @handle or a profile link. Filter by category, country or named sites. Every hit ranked high, medium or low confidence with page details. No login, no API key.",
    "version": "1.0",
    "buildTag": "latest",
    "categories": [
        "LEAD_GENERATION",
        "DEVELOPER_TOOLS",
        "AUTOMATION"
    ],
    "input": "./INPUT_SCHEMA.json",
    "output": "./output_schema.json",
    "dockerfile": "../Dockerfile",
    "readme": "../README.md",
    "storages": {
        "dataset": {
            "actorSpecification": 1,
            "title": "Social Analyzer results",
            "description": "One row per profile found, plus one summary row per run (recordType = summary).",
            "views": {
                "profiles": {
                    "title": "Profiles found",
                    "description": "Every profile that matched, strongest first. Confidence: high = the site answered exactly as a real profile does (100% match), medium = 50 to 99% and worth a manual look, low = a weak guess (only with the 'everything' setting).",
                    "transformation": {
                        "fields": [
                            "username",
                            "platform",
                            "link",
                            "confidence",
                            "matchRate",
                            "category",
                            "country",
                            "adultSite",
                            "language",
                            "pageTitle"
                        ]
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "username": {
                                "label": "Username",
                                "format": "text"
                            },
                            "platform": {
                                "label": "Platform",
                                "format": "text"
                            },
                            "link": {
                                "label": "Profile URL",
                                "format": "link"
                            },
                            "confidence": {
                                "label": "Confidence",
                                "format": "text"
                            },
                            "matchRate": {
                                "label": "Match %",
                                "format": "number"
                            },
                            "category": {
                                "label": "Category",
                                "format": "text"
                            },
                            "country": {
                                "label": "Site country",
                                "format": "text"
                            },
                            "pageTitle": {
                                "label": "Page title",
                                "format": "text"
                            },
                            "adultSite": {
                                "label": "Adult site",
                                "format": "boolean"
                            },
                            "language": {
                                "label": "Page language",
                                "format": "text"
                            }
                        }
                    }
                },
                "summary": {
                    "title": "Run summary",
                    "description": "What was checked and what came back, in one row. The same object is saved as the OUTPUT record of the run's key-value store.",
                    "transformation": {
                        "fields": [
                            "usernames",
                            "usernamesChecked",
                            "sitesPerUsername",
                            "profilesFound",
                            "highConfidence",
                            "mediumConfidence",
                            "lowConfidence",
                            "sitesNotFound",
                            "sitesFailed",
                            "durationSeconds",
                            "message"
                        ]
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "usernames": {
                                "label": "Usernames",
                                "format": "array"
                            },
                            "usernamesChecked": {
                                "label": "Checked",
                                "format": "number"
                            },
                            "sitesPerUsername": {
                                "label": "Sites each",
                                "format": "number"
                            },
                            "profilesFound": {
                                "label": "Profiles",
                                "format": "number"
                            },
                            "highConfidence": {
                                "label": "High",
                                "format": "number"
                            },
                            "mediumConfidence": {
                                "label": "Medium",
                                "format": "number"
                            },
                            "lowConfidence": {
                                "label": "Low",
                                "format": "number"
                            },
                            "sitesFailed": {
                                "label": "Did not answer",
                                "format": "number"
                            },
                            "durationSeconds": {
                                "label": "Seconds",
                                "format": "number"
                            },
                            "message": {
                                "label": "What happened",
                                "format": "text"
                            },
                            "sitesNotFound": {
                                "label": "No profile",
                                "format": "number"
                            }
                        }
                    }
                }
            }
        }
    }
}
